{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.focussessions.app",
  "productName": "Focus Sessions",
  "copyright": "Copyright © 2024 Focus Sessions App",
  "asar": true,
  "directories": {
    "output": "release/${version}",
    "buildResources": "build"
  },
  "files": [
    "dist-electron",
    "dist",
    "public/sounds/**/*"
  ],
  "extraResources": [
    {
      "from": "public/sounds",
      "to": "sounds",
      "filter": ["**/*"]
    }
  ],
  "mac": {
    "category": "public.app-category.productivity",
    "icon": "build/hour_glass.icns",
    "artifactName": "${productName}_${version}.${ext}",
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ]
  },
  "win": {
    "icon": "build/hour_glass.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}_${version}.${ext}",
    "verifyUpdateCodeSignature": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Focus Sessions",
    "installerIcon": "build/hour_glass.ico",
    "uninstallerIcon": "build/hour_glass.ico",
    "installerHeaderIcon": "build/hour_glass.ico",
    "include": "build/installer.nsh"
  },
  "portable": {
    "artifactName": "${productName}_${version}_portable.${ext}"
  },
  "linux": {
    "icon": "build/hour_glass.png",
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      }
    ],
    "category": "Office"
  }
}
