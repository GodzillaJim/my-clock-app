{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.focussessions.app",
  "productName": "Focus Sessions",
  "copyright": "Copyright © 2025-2026 Jimna Njoroge",
  "asar": true,
  "asarUnpack": [
    "node_modules/better-sqlite3/**"
  ],
  "directories": {
    "output": "release/${version}",
    "buildResources": "build"
  },
  "files": [
    "dist-electron",
    "dist",
    "public/sounds/**/*"
  ],
  "extraResources": [
    {
      "from": "public/sounds",
      "to": "sounds",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "build/hour_glass.ico",
      "to": "icons/hour_glass.ico"
    },
    {
      "from": "build/hour_glass.png",
      "to": "icons/hour_glass.png"
    }
  ],
  "win": {
    "icon": "build/hour_glass.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}_${version}.${ext}",
    "verifyUpdateCodeSignature": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Focus Sessions",
    "installerIcon": "build/hour_glass.ico",
    "uninstallerIcon": "build/hour_glass.ico",
    "installerHeaderIcon": "build/hour_glass.ico",
    "include": "build/installer.nsh"
  },
  "portable": {
    "artifactName": "${productName}_${version}_portable.${ext}"
  }
}
