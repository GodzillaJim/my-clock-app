{
  "name": "focus-sessions",
  "version": "0.1.0",
  "description": "A Windows focus timer with planned focus/break sessions, crash recovery, history and challenges.",
  "author": "Jimna Njoroge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GodzillaJim/my-clock-app.git"
  },
  "homepage": "https://github.com/GodzillaJim/my-clock-app#readme",
  "bugs": {
    "url": "https://github.com/GodzillaJim/my-clock-app/issues"
  },
  "main": "dist-electron/main/index.js",
  "private": true,
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "electron-builder install-app-deps && simple-git-hooks",
    "dev": "vite",
    "build": "tsc && vite build && electron-builder --win",
    "dist": "tsc && vite build && electron-builder --win --publish=never",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --project unit --coverage && prettier --write --log-level warn vitest.config.ts",
    "test:e2e": "vite build --mode=test && vitest run --project e2e",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run knip && npm test && vite build",
    "release:version": "commit-and-tag-version"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.5",
    "@mui/icons-material": "^9.6.0",
    "@mui/material": "^9.6.0",
    "@mui/x-date-pickers": "^9.18.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "commit-and-tag-version": "^13.5.0",
    "dayjs": "^1.11.13",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "knip": "^5.88.1",
    "lint-staged": "^17.6.2",
    "playwright": "^1.65.1",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-timer-hook": "^4.0.5",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.74.0",
    "uuid": "^11.0.3",
    "vite": "^8.4.0",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.1.2"
  },
  "simple-git-hooks": {
    "pre-commit": "if [ -x node_modules/.bin/lint-staged ]; then node_modules/.bin/lint-staged; else echo \"pre-commit: lint-staged not installed, run npm ci\"; fi",
    "commit-msg": "if [ -x node_modules/.bin/commitlint ]; then node_modules/.bin/commitlint --edit \"$1\"; else echo \"commit-msg: commitlint not installed, run npm ci\"; fi"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,html,css}": "prettier --write"
  }
}
