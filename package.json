{
  "name": "focus-sessions",
  "version": "1.0.0",
  "main": "dist-electron/main/index.js",
  "description": "A focus timer application for productive work sessions with session tracking and daily history.",
  "author": "Focus Sessions App",
  "license": "MIT",
  "private": true,
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:win": "tsc && vite build && electron-builder --win",
    "build:mac": "tsc && vite build && electron-builder --mac",
    "build:linux": "tsc && vite build && electron-builder --linux",
    "dist": "tsc && vite build && electron-builder --publish=never",
    "dist:win": "tsc && vite build && electron-builder --win --publish=never",
    "preview": "vite preview",
    "pretest": "vite build --mode=test",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && vite build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.3.0",
    "@mui/material": "^6.5.0",
    "@mui/x-date-pickers": "^8.23.0",
    "@testing-library/dom": "^10.4.1",
    "@types/uuid": "^10.0.0",
    "better-sqlite3": "^12.6.2",
    "dayjs": "^1.11.13",
    "electron-updater": "^6.3.9",
    "formik": "^2.4.6",
    "react-countdown-circle-timer": "^3.2.1",
    "react-drag-reorder": "^1.2.0",
    "react-indexed-db": "^2.0.1",
    "react-indexed-db-hook": "^1.0.14",
    "react-timer-hook": "^4.0.5",
    "uuid": "^11.0.3",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/lodash": "^4.17.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^26.1.0",
    "lodash": "^4.17.21",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.4.2",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.5"
  }
}
